# 环境变量模板（可提交 Git；真实的 .env 不提交）
#
# 复制为 .env 后填写：
#   cp .env.example .env

NODE_ENV=development
PORT=3000

# ============================================================
# 数据库
# ============================================================
# 本机开发（决策 D7）：由 `pnpm db:dev` 启动本地 Postgres，
#   用 `pnpm exec prisma dev ls` 查看实际地址后填入下面。
# 注意必须使用直连 TCP 地址（postgres://...），不要用
#   prisma+postgres:// 代理地址 —— 迁移需要 shadow database。
#
# 迁内网（决策 D13）：改为内网 PostgreSQL 地址。
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# ============================================================
# 模型服务（决策 D12 / D13）
# ============================================================
# V1 使用 DeepSeek（OpenAI 兼容协议）。
# 迁内网时，仅替换这三项指向内网自研服务，业务代码无需改动。
#
# AI_BASE_URL 必须是**OpenAI 兼容**的根地址，本项目会自行拼
# /chat/completions。DeepSeek 的两个兼容端点不要搞混：
#   OpenAI  兼容：https://api.deepseek.com            ← 用这个
#   Anthropic 兼容：https://api.deepseek.com/anthropic （路径是 /v1/messages，
#                                                      与本项目的实现不匹配）
# 填成 Anthropic 端点会得到 404（且响应体为空，很难查）。
AI_BASE_URL=
AI_API_KEY=
# 可选模型：deepseek-flash（默认）、deepseek-v4-pro
AI_MODEL=deepseek-flash
