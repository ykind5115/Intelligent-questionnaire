# 环境变量模板（可提交 Git；真实的 .env 不提交）
#
# 复制为 .env 后填写：
#   cp .env.example .env

NODE_ENV=development
PORT=3000

# ============================================================
# 数据库
# ============================================================
# 使用真实 PostgreSQL（本机安装、Docker、内网实例均可）。
# 本机安装的典型写法：
#   postgresql://<用户>:<密码>@localhost:5432/<库名>
#
# 建表与初始化：
#   pnpm db:deploy     # 按 prisma/migrations 建表（不会重置已有数据）
#   pnpm db:generate   # 生成 Prisma 客户端
#   pnpm db:seed       # 灌入测试数据（会打印 4 个测试账号的 UUID）
#
# 迁内网（决策 D13）：改为内网 PostgreSQL 地址，代码无需改动。
#
# 说明：早期版本用 `prisma dev` 的免安装实例，但那个 shim 并发下不稳定，
#   会拖慢甚至搞崩集成测试；换成真实 PostgreSQL 后同样的测试约 50 秒跑完。
DATABASE_URL="postgresql://postgres:123456@localhost:5432/postgres"

# ============================================================
# 模型服务（决策 D12 / D13）
# ============================================================
# V1 使用 DeepSeek（OpenAI 兼容协议）。
# 迁内网时，仅替换这三项指向内网自研服务，业务代码无需改动。
#
# AI_BASE_URL 必须是**OpenAI 兼容**的根地址，本项目会自行拼
# /chat/completions。DeepSeek 的两个兼容端点不要搞混：
#   OpenAI  兼容：https://api.deepseek.com            ← 用这个
#   Anthropic 兼容：https://api.deepseek.com/anthropic （路径是 /v1/messages，
#                                                      与本项目的实现不匹配）
# 填成 Anthropic 端点会得到 404（且响应体为空，很难查）。
AI_BASE_URL=
AI_API_KEY=
# 可选模型：deepseek-flash（默认）、deepseek-v4-pro
AI_MODEL=deepseek-flash
